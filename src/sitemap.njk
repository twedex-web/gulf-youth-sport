---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ site.url }}/</loc></url>
  <url><loc>{{ site.url }}/videos/</loc></url>
  <url><loc>{{ site.url }}/photos/</loc></url>
  <url><loc>{{ site.url }}/partners/</loc></url>
  <url><loc>{{ site.url }}/stories/</loc></url>
  <url><loc>{{ site.url }}/contact/</loc></url>
  <url><loc>{{ site.url }}/submit-a-story/</loc></url>
  <url><loc>{{ site.url }}/privacy/</loc></url>
{%- for story in collections.stories %}
  <url><loc>{{ site.url }}{{ story.url }}</loc><lastmod>{{ story.date | isoDate | truncate(10, true, "") }}</lastmod></url>
{%- endfor %}
</urlset>
