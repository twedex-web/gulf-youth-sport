{# Portrait 4:5 tile. With a featured photo (photoTile) the photo stays clear and the headline sits
   underneath; otherwise the headline goes inside a colour block. Expects `story` and `colour`. #}
<li class="story">
  {% if story.data.photoTile %}
  <a class="story-link" href="{{ story.url }}">
    <span class="tile tile--photo">
      <img class="tile-photo" src="{{ story.data.image }}" alt="" loading="lazy" decoding="async">
      {% if story.data.kicker %}<span class="kicker">{{ story.data.kicker }}</span>{% endif %}
    </span>
    <h3 class="story-title">{{ story.data.title }}</h3>
  </a>
  {% else %}
  <a class="tile tile--{{ colour }}" href="{{ story.url }}">
    {% if story.data.kicker %}<span class="kicker">{{ story.data.kicker }}</span>{% endif %}
    <h3 class="tile-title">{{ story.data.title }}</h3>
  </a>
  {% endif %}
  <p class="story-date"><time datetime="{{ story.date | isoDate }}">{{ story.date | readableDate }}</time></p>
</li>
