---
permalink: /build.json
eleventyExcludeFromCollections: true
---
{
  "builtAt": {{ build.time | dump | safe }},
  "trigger": {{ build.trigger | dump | safe }},
  "context": {{ build.context | dump | safe }},
  "commit": {{ build.commit | dump | safe }},
  "stories": {{ collections.stories.length }},
  "latestStory": {{ (collections.stories[0].url if collections.stories.length else null) | dump | safe }},
  "videos": {{ youtube.videos.length }},
  "latestVideo": {{ (youtube.videos[0].title if youtube.videos.length else null) | dump | safe }},
  "galleries": {{ zenfolio.galleries.length }},
  "latestGallery": {{ (zenfolio.galleries[0].title if zenfolio.galleries.length else null) | dump | safe }}
}
